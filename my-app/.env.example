# ============================================================================
# Copy to .env and fill in. Never commit .env — it is gitignored.
#
#   cp .env.example .env
#
# All five required values come from your Supabase project:
#   Dashboard → Project Settings → API
# ============================================================================

# ── Supabase (required) ─────────────────────────────────────────────────────

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe to ship to browsers — every table it can reach is
# protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET — bypasses ALL row level security.
# Server-side only (lib/supabase/admin.ts). Never expose it to the browser,
# never prefix it with NEXT_PUBLIC_, never paste it into a client component.
SUPABASE_SERVICE_ROLE_KEY=


# ── Site (required) ─────────────────────────────────────────────────────────

# Canonical origin, no trailing slash. Drives metadataBase, every canonical
# tag, sitemap.xml, robots.txt and all JSON-LD @ids — so pick with-www or
# without-www and 301 the other, then keep this matching that choice.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.almajdouie.org


# ── Map (required for the mosque map on /focus-areas/mosques) ───────────────

# MapTiler API key — free tier at https://cloud.maptiler.com/account/keys/
# Without it the map renders its fallback message; the rest of the page works.
NEXT_PUBLIC_MAPTILER_KEY=


# ── Optional ────────────────────────────────────────────────────────────────

# External grant portal ("بوابة المنح" in the nav). Falls back to "#".
NEXT_PUBLIC_GRANT_PORTAL_URL=
